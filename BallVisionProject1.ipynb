        with open(DATA_YAML_PITCH, 'r', encoding='utf-8') as f: data_yaml = yaml.safe_load(f)
        if data_yaml and 'kpt_shape' in data_yaml and isinstance(data_yaml['kpt_shape'], list) and len(data_yaml['kpt_shape'])>0: num_kpts=int(data_yaml['kpt_shape'][0])
        else: num_kpts=23; print("Warn: Assuming 23 kpts.")
