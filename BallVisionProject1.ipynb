def draw_pitch_points_with_labels(img, kpts, conf_th, radius, color, text_color, font_scale):
    """Draws pitch keypoints and their labels on the image."""
    if kpts is None or kpts.shape[0] == 0: return img
    out = img.copy()
    for i, (x, y, c) in enumerate(kpts):
        if c >= conf_th:
            ix, iy = int(x), int(y)
            cv2.circle(out, (ix, iy), radius + 1, (0, 0, 0), -1) # Outline
            cv2.circle(out, (ix, iy), radius, color, -1)
            text_pos = (ix + radius + 2, iy + radius // 2)
            cv2.putText(out, str(i), text_pos, cv2.FONT_HERSHEY_SIMPLEX, font_scale, text_color, 1, cv2.LINE_AA)
    return out

def draw_pitch_lines_on_original(img, kpts, conf_th, line_pairs, color, thickness):
    """Draws lines between specified pitch keypoints on the image."""
    if kpts is None or kpts.shape[0] == 0: return img
    out = img.copy(); max_idx_needed = 0
    try: max_idx_needed = max(max(pair) for pair in line_pairs) if line_pairs else 0
    except ValueError: return out # Should not happen with valid pairs
    if kpts.shape[0] <= max_idx_needed: return out # Not enough keypoints detected
    for start_idx, end_idx in line_pairs:
        if start_idx < kpts.shape[0] and end_idx < kpts.shape[0]:
            if kpts[start_idx, 2] >= conf_th and kpts[end_idx, 2] >= conf_th:
                pt1 = (int(kpts[start_idx, 0]), int(kpts[start_idx, 1]))
                pt2 = (int(kpts[end_idx, 0]), int(kpts[end_idx, 1]))
                cv2.line(out, pt1, pt2, color, thickness)
    return out

def update_homography(kpts, kpt_conf_th, pitch_landmarks_2d_ref_coords):
    global H_raw, H_global, HOMOGRAPHY_SMOOTHING_ALPHA
    H_raw = None
    if kpts is None or kpts.shape[0] == 0 or pitch_landmarks_2d_ref_coords is None or pitch_landmarks_2d_ref_coords.shape[0] == 0: return False
    valid_indices_conf = np.where(kpts[:, 2] >= kpt_conf_th)[0]
    valid_indices = list(valid_indices_conf)
    if len(valid_indices) < 4: return False
    max_valid_idx = max(valid_indices) if valid_indices else -1
    if pitch_landmarks_2d_ref_coords.shape[0] <= max_valid_idx: return False
    img_pts = kpts[valid_indices, :2].astype(np.float32); obj_pts = pitch_landmarks_2d_ref_coords[valid_indices, :].astype(np.float32)
    if img_pts.shape[0] != obj_pts.shape[0] or img_pts.shape[0] < 4: return False
    try:
        H_calc, mask = cv2.findHomography(img_pts, obj_pts, cv2.RANSAC, 5.0)
        if H_calc is not None:
            try:
                determinant = np.linalg.det(H_calc)
                if abs(determinant) > 1e-7:
                    H_raw = H_calc
                    if H_global is None: H_global = H_raw
                    else: H_global = HOMOGRAPHY_SMOOTHING_ALPHA * H_raw + (1.0 - HOMOGRAPHY_SMOOTHING_ALPHA) * H_global
                    return True
                else: return False
            except np.linalg.LinAlgError: return False
        else: return False
    except cv2.error: return False
    except Exception: return False

def warp_points(pts):
    global H_global
    if H_global is None or not isinstance(pts, np.ndarray) or pts.size == 0: return np.empty((0,2), dtype=np.float32)
    pts_arr = pts.reshape(-1, 1, 2).astype(np.float32)
    try:
        warped = cv2.perspectiveTransform(pts_arr, H_global);
        return warped.reshape(-1, 2) if warped is not None else np.empty((0,2), dtype=np.float32)
    except cv2.error: return np.empty((0,2), dtype=np.float32)
    except Exception: return np.empty((0,2), dtype=np.float32)

def is_valid_2d_position(pos_2d):
    global PITCH_2D_BOUNDS_X_MIN, PITCH_2D_BOUNDS_X_MAX, PITCH_2D_BOUNDS_Y_MIN, PITCH_2D_BOUNDS_Y_MAX
    if pos_2d is None or not isinstance(pos_2d, np.ndarray) or pos_2d.size != 2: return False
    x, y = pos_2d; return PITCH_2D_BOUNDS_X_MIN <= x <= PITCH_2D_BOUNDS_X_MAX and PITCH_2D_BOUNDS_Y_MIN <= y <= PITCH_2D_BOUNDS_Y_MAX

def get_team_from_static_hsv(frame, box):
    global ROI_START_PERCENT, ROI_FOCUS_HEIGHT_PERCENT, FEATURE_MASK_LOW_HSV, FEATURE_MASK_HIGH_HSV
    global GK_COLOR_CHECK_ENABLED, GK_STATIC_H_MIN, GK_STATIC_H_MAX, GK_STATIC_MIN_S, GK_STATIC_MIN_V
    global STATIC_HSV_TEAM1_MAX_S, STATIC_HSV_TEAM1_MIN_V
    global STATIC_HSV_TEAM0_H_MIN, STATIC_HSV_TEAM0_H_MAX, STATIC_HSV_TEAM0_MIN_S, STATIC_HSV_TEAM0_MIN_V
    global STATIC_HSV_REFEREE_H_MIN, STATIC_HSV_REFEREE_H_MAX, STATIC_HSV_REFEREE_MIN_S, STATIC_HSV_REFEREE_MIN_V
    try:
        x1, y1, x2, y2 = map(int, box); patch_h = y2 - y1
        if patch_h <= 0: return -1
        roi_y_start = max(y1, y1 + int(patch_h * ROI_START_PERCENT)); roi_y_end = min(y2, y1 + int(patch_h * ROI_START_PERCENT + patch_h * ROI_FOCUS_HEIGHT_PERCENT))
        roi_x_start = x1; roi_x_end = x2
        if roi_y_start >= roi_y_end or roi_x_start >= roi_x_end: return -1
        patch = frame[roi_y_start:roi_y_end, roi_x_start:roi_x_end]
        if patch.size == 0: return -1
        hsv_patch = cv2.cvtColor(patch, cv2.COLOR_BGR2HSV)
        mask_general = cv2.inRange(hsv_patch, FEATURE_MASK_LOW_HSV, FEATURE_MASK_HIGH_HSV)
        if mask_general.size == 0 or cv2.countNonZero(mask_general) < (mask_general.size * 0.10): return -1
        mean_hsv = cv2.mean(hsv_patch, mask=mask_general)
        if len(mean_hsv) < 3: return -1
        h, s, v = mean_hsv[0], mean_hsv[1], mean_hsv[2]
        if GK_COLOR_CHECK_ENABLED and GK_STATIC_H_MIN <= h <= GK_STATIC_H_MAX and s >= GK_STATIC_MIN_S and v >= GK_STATIC_MIN_V: return 3
        if s <= STATIC_HSV_TEAM1_MAX_S and v >= STATIC_HSV_TEAM1_MIN_V: return 1
        if STATIC_HSV_TEAM0_H_MIN <= h <= STATIC_HSV_TEAM0_H_MAX and s >= STATIC_HSV_TEAM0_MIN_S and v >= STATIC_HSV_TEAM0_MIN_V: return 0
        if STATIC_HSV_REFEREE_H_MIN <= h <= STATIC_HSV_REFEREE_H_MAX and s >= STATIC_HSV_REFEREE_MIN_S and v >= STATIC_HSV_REFEREE_MIN_V: return 2
        return -1
    except cv2.error: return -1
    except Exception: return -1

def label_clusters_by_color(centers_original, new_cluster_map):
    t0_center_hsv_str = 'N/A'; t1_center_hsv_str = 'N/A'
    if not isinstance(centers_original, np.ndarray) or not isinstance(new_cluster_map, dict): return
    try:
        original_index_t0 = -1; original_index_t1 = -1
        for k_idx, team_id in new_cluster_map.items():
            if team_id == 0: original_index_t0 = k_idx
            elif team_id == 1: original_index_t1 = k_idx
        if 0 <= original_index_t0 < centers_original.shape[0]:
            center_array_t0 = centers_original[original_index_t0]
            if isinstance(center_array_t0, np.ndarray) and center_array_t0.ndim == 1 and center_array_t0.size >= 3:
                t0_center_hsv_str = f"[{', '.join([f'{val:.1f}' for val in center_array_t0])}]"
            else: t0_center_hsv_str = f"Invalid T0 Center Array (Idx:{original_index_t0})"
        elif 0 in new_cluster_map.values(): t0_center_hsv_str = 'Index Error'
        if 0 <= original_index_t1 < centers_original.shape[0]:
            center_array_t1 = centers_original[original_index_t1]
            if isinstance(center_array_t1, np.ndarray) and center_array_t1.ndim == 1 and center_array_t1.size >= 3:
                t1_center_hsv_str = f"[{', '.join([f'{val:.1f}' for val in center_array_t1])}]"
            else: t1_center_hsv_str = f"Invalid T1 Center Array (Idx:{original_index_t1})"
        elif 1 in new_cluster_map.values(): t1_center_hsv_str = 'Index Error'
        print(f"  Centers HSV: T0={t0_center_hsv_str}, T1={t1_center_hsv_str}")
    except Exception as e: print(f"❌ Error formatting cluster centers: {e}"); traceback.print_exc()

def calculate_iou(box1, box2):
    if box1 is None or box2 is None or len(box1) < 4 or len(box2) < 4: return 0.0
    try:
        x1_i=max(box1[0],box2[0]); y1_i=max(box1[1],box2[1]); x2_i=min(box1[2],box2[2]); y2_i=min(box1[3],box2[3])
        inter_area=max(0,x2_i-x1_i)*max(0,y2_i-y1_i); box1_area=(box1[2]-box1[0])*(box1[3]-box1[1]); box2_area=(box2[2]-box2[0])*(box2[3]-box2[1])
        if box1_area <= 0 or box2_area <= 0: return 0.0
        union_area=box1_area+box2_area-inter_area; return inter_area/union_area if union_area>0 else 0.0
    except (TypeError, IndexError): return 0.0

def draw_pitch_outline(img, x1, y1, x2, y2, color, thickness):
    global PITCH_WIDTH_METERS, PITCH_HEIGHT_METERS, PITCH_HALFWAY_LINE_X
    global PITCH_PENALTY_AREA_HALF_WIDTH, PITCH_PENALTY_AREA_DEPTH, PITCH_PENALTY_SPOT_DIST
    h, w = y2 - y1, x2 - x1
    if h <= 0 or w <= 0 or PITCH_WIDTH_METERS <= 0 or PITCH_HEIGHT_METERS <= 0: return img
    def scale_pt(pt_meters):
        px = pt_meters[0] / PITCH_WIDTH_METERS * w; py = pt_meters[1] / PITCH_HEIGHT_METERS * h
        return (int(x1 + px), int(y2 - py))
    try:
        cv2.rectangle(img, (x1, y1), (x2, y2), color, thickness)
        cv2.line(img, scale_pt((PITCH_HALFWAY_LINE_X, 0)), scale_pt((PITCH_HALFWAY_LINE_X, PITCH_HEIGHT_METERS)), color, thickness)
        center_scaled = scale_pt((PITCH_HALFWAY_LINE_X, PITCH_HEIGHT_METERS/2))
        radius_scaled = int(9.15 / PITCH_HEIGHT_METERS * h)
        if radius_scaled > 0: cv2.circle(img, center_scaled, radius_scaled, color, thickness)
        pa_y1 = PITCH_HEIGHT_METERS/2 - PITCH_PENALTY_AREA_HALF_WIDTH; pa_y2 = PITCH_HEIGHT_METERS/2 + PITCH_PENALTY_AREA_HALF_WIDTH
        cv2.rectangle(img, scale_pt((0, pa_y1)), scale_pt((PITCH_PENALTY_AREA_DEPTH, pa_y2)), color, thickness)
        cv2.rectangle(img, scale_pt((PITCH_WIDTH_METERS - PITCH_PENALTY_AREA_DEPTH, pa_y1)), scale_pt((PITCH_WIDTH_METERS, pa_y2)), color, thickness)
        spot_radius = max(1, thickness // 2)
        cv2.circle(img, scale_pt((PITCH_PENALTY_SPOT_DIST, PITCH_HEIGHT_METERS/2)), spot_radius, color, -1)
        cv2.circle(img, scale_pt((PITCH_WIDTH_METERS - PITCH_PENALTY_SPOT_DIST, PITCH_HEIGHT_METERS/2)), spot_radius, color, -1)
    except Exception as e: print(f"⚠️ WARNING: Error drawing pitch outline elements: {e}")
    return img

def point_segment_distance(px, py, x1, y1, x2, y2):
    try:
        line_mag_sq = (x2 - x1)**2 + (y2 - y1)**2
        if line_mag_sq < 1e-6: return math.hypot(px - x1, py - y1)
        u = ((px - x1) * (x2 - x1) + (py - y1) * (y2 - y1)) / line_mag_sq
        u = max(0, min(1, u)); closest_x = x1 + u * (x2 - x1); closest_y = y1 + u * (y2 - y1)
        return math.hypot(px - closest_x, py - closest_y)
    except Exception: return float('inf')

