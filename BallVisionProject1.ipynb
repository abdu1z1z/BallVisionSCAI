                        elif static_id in [0, 1]: color_tid = static_id
                        elif color_tid == -1 and SKLEARN_AVAILABLE and kmeans_ready and cfeat and cluster_label_map:
                            try: # --- Specific try for KMeans prediction ---
                                feature_array = np.array(cfeat).reshape(1, -1)
                                if scaler is not None and kmeans is not None and feature_array.shape[1] == scaler.n_features_in_: # Check if scaler/kmeans exist
                                    scaled_feature = scaler.transform(feature_array)
                                    cluster_idx = kmeans.predict(scaled_feature)[0]
                                    kmeans_tid = cluster_label_map.get(cluster_idx, -1)
