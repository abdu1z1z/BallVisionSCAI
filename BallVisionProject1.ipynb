                                    tm_box_sort = tm['box']; tm_center_sort = (int((tm_box_sort[0]+tm_box_sort[2])/2), int((tm_box_sort[1]+tm_box_sort[3])/2))
                                    tm['dist_to_carrier_frame'] = math.hypot(carrier_center_frame[0]-tm_center_sort[0], carrier_center_frame[1]-tm_center_sort[1])
