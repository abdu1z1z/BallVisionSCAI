                                dist = np.linalg.norm(p['pos_2d'] - ball_pos_2d_current)
                                if dist < min_dist_to_ball and dist < MIN_CARRIER_DIST:
                                    min_dist_to_ball = dist; ball_carrier_obj = p; current_possessing_team_id = p['team_id']
                            except Exception as dist_err:
                                # print(f"DEBUG: Error calculating distance for possession: {dist_err}") # Less verbose
                                pass

                # Set ball visual color based on possession
                if current_possessing_team_id == 0: current_ball_visual_color = TEAM_0_COLOR
                elif current_possessing_team_id == 1: current_ball_visual_color = TEAM_1_COLOR
                else: current_ball_visual_color = BALL_COLOR # Default if no possession

                # --- Detect Ball Recovery ---
                if previous_possessing_team_id != -1 and current_possessing_team_id != -1 and previous_possessing_team_id != current_possessing_team_id:
                    recovering_team_id = current_possessing_team_id
                    min_dist_recovery = float('inf'); recovery_player_id = None; recovery_pos_2d = ball_pos_2d_current
                    for p in final_objects_for_drawing:
                        if p['cls_id'] == PLAYER_CLS_ID and p['team_id'] == recovering_team_id and p.get('pos_2d') is not None:
                            try: # --- Inner try for distance calc ---
                                dist_rec = np.linalg.norm(p['pos_2d'] - ball_pos_2d_current)
                                if dist_rec < min_dist_recovery: min_dist_recovery = dist_rec; recovery_player_id = p.get('player_id')
                            except Exception as dist_err_rec:
                                # print(f"DEBUG: Error calculating distance for recovery: {dist_err_rec}") # Less verbose
                                pass
                    if recovery_player_id is not None and recovery_pos_2d is not None:
                        ball_recoveries.append({'frame': frame_idx, 'team_id': recovering_team_id, 'player_id': recovery_player_id, 'pos_2d': recovery_pos_2d.copy()})
                previous_possessing_team_id = current_possessing_team_id

                # --- Update total possession counters & possession in thirds ---
