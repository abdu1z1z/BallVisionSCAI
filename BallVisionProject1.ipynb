    replacements['{{LANES_T0}}'] = f"{report_data.get('lanes_t0', 0):.1f}%"; replacements['{{LANES_T1}}'] = f"{report_data.get('lanes_t1', 0):.1f}%"
    replacements['{{PRESSURE_T0}}'] = f"{report_data.get('pressure_t0', 0):.2f}"; replacements['{{PRESSURE_T1}}'] = f"{report_data.get('pressure_t1', 0):.2f}"
    replacements['{{T0_DEF_PERC}}'] = f"{report_data.get('t0_def', 0):.1f}%"; replacements['{{T0_MID_PERC}}'] = f"{report_data.get('t0_mid', 0):.1f}%"; replacements['{{T0_ATT_PERC}}'] = f"{report_data.get('t0_att', 0):.1f}%"; replacements['{{T0_EFF}}'] = str(report_data.get('t0_eff', 'N/A'))
    replacements['{{T1_DEF_PERC}}'] = f"{report_data.get('t1_def', 0):.1f}%"; replacements['{{T1_MID_PERC}}'] = f"{report_data.get('t1_mid', 0):.1f}%"; replacements['{{T1_ATT_PERC}}'] = f"{report_data.get('t1_att', 0):.1f}%"; replacements['{{T1_EFF}}'] = str(report_data.get('t1_eff', 'N/A'))
    if report_data.get('recovery_success', False) and report_data.get("recovery_file"):
        recovery_img_html = f'<img src="{Path(report_data.get("recovery_file", "")).name}" alt="Recovery Heatmap" class="report-img">'
    else: recovery_img_html = "<p class='text-gray-500'>لم يتم إنشاء خريطة حرارية لاستعادة الكرة.</p>"
    replacements['{{RECOVERY_IMG_SECTION}}'] = recovery_img_html
    top_recs = report_data.get('top_recoverers', []); all_recoveries = report_data.get('all_recoveries', [])
    top_recs_html = ''
    if top_recs:
        for i, (player_id, count) in enumerate(top_recs):
            player_team_id = next((rec.get('team_id', -1) for rec in all_recoveries if rec.get('player_id') == player_id), -1)
            team_color_class = "team0-color" if player_team_id == 0 else ("team1-color" if player_team_id == 1 else "text-gray-400")
            team_badge_class = "team0-badge" if player_team_id == 0 else ("team1-badge" if player_team_id == 1 else "bg-gray-500 text-white")
            team_label = f"الفريق الأول" if player_team_id == 0 else (f"الفريق الثاني" if player_team_id == 1 else "غير معروف")
            top_recs_html += f"""<li class="recoverer-item"><div><span class="team-badge {team_badge_class}">{team_label}</span><span class="player-id {team_color_class}">لاعب رقم {player_id}</span></div><div class="stat-highlight">{count} مرات استعادة</div></li>"""
    else: top_recs_html = "<li class='text-gray-500 p-3'>لا توجد بيانات استعادة كافية.</li>"
    replacements['{{TOP_RECOVERERS_LIST}}'] = top_recs_html
    if report_data.get('isolation_t0_success', False) and report_data.get("isolation_t0_file"):
        iso_t0_img_html = f'<img src="{Path(report_data.get("isolation_t0_file", "")).name}" alt="Team 0 Isolation Map" class="report-img">'
    else: iso_t0_img_html = "<p class='text-gray-500'>لا توجد بيانات عزلة للفريق الأول.</p>"
    replacements['{{ISOLATION_T0_IMG_SECTION}}'] = iso_t0_img_html
    if report_data.get('isolation_t1_success', False) and report_data.get("isolation_t1_file"):
        iso_t1_img_html = f'<img src="{Path(report_data.get("isolation_t1_file", "")).name}" alt="Team 1 Isolation Map" class="report-img">'
    else: iso_t1_img_html = "<p class='text-gray-500'>لا توجد بيانات عزلة للفريق الثاني.</p>"
    replacements['{{ISOLATION_T1_IMG_SECTION}}'] = iso_t1_img_html
    snapshot_frame_num = report_data.get('snapshot_frame', 'N/A')
    snapshot_time_sec = (snapshot_frame_num / report_data.get('avg_fps', 1)) if isinstance(snapshot_frame_num, int) and report_data.get('avg_fps', 0) > 0 else 'N/A'
    snapshot_time_str = f"{snapshot_time_sec:.1f}" if isinstance(snapshot_time_sec, float) else 'N/A'
    replacements['{{SNAPSHOT_FRAME}}'] = str(snapshot_frame_num) # For display in title
    replacements['{{SNAPSHOT_TIME}}'] = snapshot_time_str
    replacements['{{SNAPSHOT_PRESSURE}}'] = report_data.get('snapshot_pressure', 'الضغط: N/A')
    replacements['{{SNAPSHOT_CLOSEST_OPPONENT}}'] = str(report_data.get('snapshot_closest_opponent_dist', 'N/A'))
    # --- ✅ Dynamic snapshot insights (example, needs actual logic in Python) ---
    # These would be calculated and passed in report_data
    replacements['{{SNAPSHOT_SPACE_DESC}}'] = report_data.get('snapshot_space_desc', "المساحة المتاحة أمام اللاعب [واسعة/محدودة] بسبب [سبب المساحة].")
    replacements['{{SNAPSHOT_PASS_OPTIONS_DESC}}'] = report_data.get('snapshot_pass_options_desc', f"يوجد [{report_data.get('snapshot_open_lanes_count',0)}] خيار تمرير مفتوح (أخضر) إلى [وصف الزملاء].")
    replacements['{{SNAPSHOT_BLOCKED_PASS_DESC}}'] = report_data.get('snapshot_blocked_pass_desc', "خيار التمرير إلى [وصف الخيار] مغلق (أحمر) بسبب [سبب الإغلاق].")
    replacements['{{SNAPSHOT_PRESSURE_LEVEL_DESC}}'] = report_data.get('snapshot_pressure_level_desc', f"مستوى الضغط المباشر يعتبر [مرتفع/متوسط/منخفض] (أقرب لاعب على بعد {report_data.get('snapshot_closest_opponent_dist', 'N/A')}م).")
    replacements['{{SNAPSHOT_TACTICAL_CONCLUSION}}'] = report_data.get('snapshot_tactical_conclusion', "في هذه اللحظة، يبدو أن الخيار الأمثل لحامل الكرة هو <strong>[وصف الخيار الأفضل]</strong> وذلك لـ <strong>[سبب اختيار الخيار]</strong>. محاولة <strong>[وصف خيار آخر]</strong> قد تكون محفوفة بالمخاطر بسبب <strong>[سبب المخاطرة]</strong>.")

    if report_data.get('snapshot_success', False) and report_data.get("snapshot_file"):
        snapshot_filename = Path(report_data.get("snapshot_file", "")).name
        # This HTML structure will be filled by the placeholders above
        snapshot_html_content = f"""
                <div class="bg-gray-700 rounded-lg p-4">
                    <div class="text-center mb-4">
                        <span class="text-lg font-semibold">إطار رقم: {snapshot_frame_num}</span> | <span class="text-gray-400">الثانية: {snapshot_time_str}</span>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-center">
                        <div>
                            <div class="bg-gray-800 rounded-lg p-2 feature-image">
                                <img src="{snapshot_filename}" alt="Key Moment Snapshot" class="max-w-full h-auto rounded-md block">
                            </div>
                             <p class="image-caption">{report_data.get('snapshot_pressure', 'الضغط: N/A')}</p>
                        </div>
                        <div>
                            <h3 class="section-subtitle text-center">تحليل اللقطة</h3>
                            <ul class="list-disc pr-5 text-gray-300 space-y-2 mb-4">
                                <li>{replacements['{{SNAPSHOT_SPACE_DESC}}']}</li>
                                <li>{replacements['{{SNAPSHOT_PASS_OPTIONS_DESC}}']}</li>
                                <li>{replacements['{{SNAPSHOT_BLOCKED_PASS_DESC}}']}</li>
                                <li>{replacements['{{SNAPSHOT_PRESSURE_LEVEL_DESC}}']}</li>
                            </ul>
                             <p class="feature-benefit">
                                <strong>الاستنتاج التكتيكي:</strong> {replacements['{{SNAPSHOT_TACTICAL_CONCLUSION}}']}
                            </p>
                        </div>
                    </div>
                </div>
                """
        replacements['{{SNAPSHOT_SECTION}}'] = snapshot_html_content
    else:
        replacements['{{SNAPSHOT_SECTION}}'] = "<p class='text-gray-500'>لم يتم التقاط لقطة للمساحات المتاحة.</p>"

    html_content = template_string
    for placeholder, value in replacements.items():
        html_content = html_content.replace(placeholder, str(value))
    try:
        with open(output_path, 'w', encoding='utf-8') as f: f.write(html_content)
        print(f"   HTML Report saved successfully to: {output_path.resolve()}")
        return True
    except Exception as e_html: print(f"❌ Error saving HTML report: {e_html}"); return False

