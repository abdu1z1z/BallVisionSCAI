                    if carrier_team_id != -1:
                        carrier_box = ball_carrier_obj['box']; carrier_center_frame = (int((carrier_box[0]+carrier_box[2])/2), int((carrier_box[1]+carrier_box[3])/2))
                        carrier_pos_map = ball_carrier_obj.get('pos_2d'); carrier_draw_map = None
                        if carrier_pos_map is not None:
                            carrier_draw_map = (int(carrier_pos_map[0]*scale2d), int((PITCH_HEIGHT_METERS-carrier_pos_map[1])*scale2d))
                            can_draw_map_lanes = can_draw_map_lanes and (0 <= carrier_draw_map[0] < map_w and 0 <= carrier_draw_map[1] < map_h)

                        teammates = [p for p in final_objects_for_drawing if p['cls_id'] == PLAYER_CLS_ID and p.get('player_id') != ball_carrier_obj.get('player_id') and p['team_id'] == carrier_team_id]
                        opponents_viz = [p for p in final_objects_for_drawing if p['cls_id'] == PLAYER_CLS_ID and p['team_id'] != -1 and p['team_id'] != carrier_team_id]

                        if teammates:
