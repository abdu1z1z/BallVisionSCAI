                alpha = 0.4; cv2.addWeighted(overlay, alpha, annotated_frame, 1 - alpha, 0, annotated_frame)
                t0_width = cv2.getTextSize(f"T0 {poss_perc_t0:.1f}%", cv2.FONT_HERSHEY_SIMPLEX, 0.6, 2)[0][0]; dash_width = cv2.getTextSize(" - ", cv2.FONT_HERSHEY_SIMPLEX, 0.6, 2)[0][0]
                cv2.putText(annotated_frame, f"T0 {poss_perc_t0:.1f}%", (text_x, text_y), cv2.FONT_HERSHEY_SIMPLEX, 0.6, TEAM_0_COLOR, 2, cv2.LINE_AA)
