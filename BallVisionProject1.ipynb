                    obj_info = {'box': det['box'], 'cls_id': det['cls_id'], 'conf': det['conf'], 'pos_2d': obj_pos_2d, 'frames_since_match': 0}
                    if det['cls_id'] == REFEREE_CLS_ID: obj_info['team_id'] = 2
                    elif det['cls_id'] == BALL_CLS_ID: obj_info['team_id'] = -1; ball_pos_2d_current = obj_pos_2d
                    final_objects_for_drawing.append(obj_info)

