    except Exception as e: print(f"Error loading YAML: {e}"); return
    print(f"Expected keypoints: {num_kpts}")
    # Load Models
    model_pitch, model_players = None, None; player_model_names = {};
    # --- ✅ Initialize Class IDs before try block ---
    PLAYER_CLS_ID, BALL_CLS_ID, REFEREE_CLS_ID = -1, -1, -1
    try:
        model_pitch=YOLO(MODEL_PATH_PITCH); model_players=YOLO(MODEL_PATH_PLAYERS)
        if hasattr(model_players, 'names'): player_model_names=model_players.names
        else: raise ValueError("Can't get class names")
        id_player=[k for k,v in player_model_names.items() if v==CLASS_PLAYER]; id_ball=[k for k,v in player_model_names.items() if v==CLASS_BALL]; id_referee=[k for k,v in player_model_names.items() if v==CLASS_REFEREE]
        PLAYER_CLS_ID=id_player[0] if id_player else -1; BALL_CLS_ID=id_ball[0] if id_ball else -1; REFEREE_CLS_ID=id_referee[0] if id_referee else -1
        if -1 in [PLAYER_CLS_ID, BALL_CLS_ID]: raise ValueError(f"Missing Player/Ball class ID.")
        if REFEREE_CLS_ID == -1: print("Warn: Referee class not found.")
        print(f"IDs -> P:{PLAYER_CLS_ID}, B:{BALL_CLS_ID}, R:{REFEREE_CLS_ID}"); print("Models loaded.")
    except Exception as e: print(f"Error loading models: {e}"); return

    # --- Open Video and Get Properties ---
    cap = None; fps, w, h = 30.0, 1280, 720
    try:
        cap=cv2.VideoCapture(str(VIDEO_PATH_IN)); assert cap.isOpened(), f"Cannot open: {VIDEO_PATH_IN}"
        _fps=cap.get(cv2.CAP_PROP_FPS); fps=float(_fps) if _fps and _fps>0 else 30.0
        _w=int(cap.get(cv2.CAP_PROP_FRAME_WIDTH)); _h=int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))
        if not (_w > 0 and _h > 0):
            print("Reading first frame to get dimensions...")
            ret_tmp,frame_tmp=cap.read()
            if not ret_tmp: raise IOError("Cannot read first frame to determine video dimensions.")
            _h,_w=frame_tmp.shape[:2]; cap.set(cv2.CAP_PROP_POS_FRAMES, 0) # Reset position
        w,h=_w,_h; print(f"Video: {w}x{h} @ {fps:.2f} FPS")
    except Exception as e: print(f"Error opening video: {e}"); cap.release() if cap and cap.isOpened() else None; return

    # --- Calculate KMeans Frame Thresholds ---
    KMEANS_WARMUP_FRAMES = int(KMEANS_WARMUP_SECONDS * fps); RETRAIN_INTERVAL_FRAMES = int(RETRAIN_INTERVAL_SECONDS * fps)
    print(f"KMeans: Warmup={KMEANS_WARMUP_FRAMES}f, Retrain={RETRAIN_INTERVAL_FRAMES}f")

    # --- Initialize Video Writers ---
    writer_main, writer_map = None, None; output_path_main, output_path_map = None, None
    try:
        # --- ✅ Changed FourCC to XVID and extension to .avi ---
        fourcc=cv2.VideoWriter_fourcc(*'XVID')
        output_path_main=VIDEO_PATH_OUT
        writer_main=cv2.VideoWriter(str(output_path_main), fourcc, fps, (w, h))
        assert writer_main.isOpened(), f"Failed main writer for {output_path_main}"

        output_path_map=VIDEO_PATH_MAP_OUT
        writer_map=cv2.VideoWriter(str(output_path_map), fourcc, fps, (map_w, map_h))
        assert writer_map.isOpened(), f"Failed map writer for {output_path_map}"
        print(f"Main out: {output_path_main}"); print(f"Map out: {output_path_map}")
    except Exception as e: print(f"❌ Error initializing writers: {e}"); writer_main.release() if writer_main else None; writer_map.release() if writer_map else None; cap.release() if cap else None; return

    # --- Initialize Processing Variables ---
    frame_idx = 0; start_time = time.time() # Make start_time global if needed in __main__
    processing_fps_list = deque(maxlen=int(fps*4))
    # Reset state variables (already global)
    player_tracks = {}; next_player_id = 0
    heatmap_grid = np.zeros(HEATMAP_GRID_SIZE, dtype=np.float32)
    H_global = None
    possession_frames_team0 = 0; possession_frames_team1 = 0
    poss_frames_t0_third1 = 0; poss_frames_t0_third2 = 0; poss_frames_t0_third3 = 0
    poss_frames_t1_third1 = 0; poss_frames_t1_third2 = 0; poss_frames_t1_third3 = 0
    best_space_frame_data = {'frame_idx': -1, 'score': -1, 'open_cells': [], 'objects': []}
    ball_recoveries = []
    previous_possessing_team_id = -1
    open_lanes_count_t0 = 0; total_lanes_count_t0 = 0
    open_lanes_count_t1 = 0; total_lanes_count_t1 = 0
    pressure_index_sum_t0 = 0.0; pressure_frames_count_t0 = 0
    pressure_index_sum_t1 = 0.0; pressure_frames_count_t1 = 0
    fully_blocked_situations = []
    # --- ✅ Initialize report generation status variables ---
    snapshot_success = False
    recovery_heatmap_success = False
    isolation_map_t0_success = False
    isolation_map_t1_success = False
    snapshot_pressure_info_text = "الضغط: N/A"

    # -------------------------------------------------------------------------
    #                           Main Processing Loop
    # -------------------------------------------------------------------------
    print("Starting main processing loop...")
    while True:
        loop_start_time = time.time()
        try: # --- Outer try for the whole loop iteration ---
            ret, frame = cap.read()
            if not ret:
                print("\nEnd of video.")
                break # Exit loop cleanly at video end

            frame_idx += 1
            # if frame_idx % 100 == 0: # Print progress marker less frequently
            #     print(f"\nProcessing frame {frame_idx}...")

            annotated_frame = frame.copy()
            # --- ✅ Initialize pitch_vis with background or blank ---
            pitch_background_img_loop = None
            if BACKGROUND_PITCH_IMAGE_PATH.exists():
                try:
                    pitch_background_img_loop = cv2.imread(str(BACKGROUND_PITCH_IMAGE_PATH))
                    if pitch_background_img_loop is not None:
                        pitch_vis = cv2.resize(pitch_background_img_loop, (map_w, map_h), interpolation=cv2.INTER_AREA)
                    else:
                        # print(f"DEBUG: Failed to load background image in loop, using blank. F:{frame_idx}") # Less verbose
                        pitch_vis = blank_pitch.copy() # Fallback to blank
                except Exception as bg_err:
                    # print(f"DEBUG: Error loading/resizing background image in loop: {bg_err}. F:{frame_idx}") # Less verbose
                    pitch_vis = blank_pitch.copy() # Fallback to blank on error
            else:
                pitch_vis = blank_pitch.copy() # Fallback to blank if no path
            # --- End pitch_vis initialization ---


            # --- 1. Pitch Layout and Homography ---
            pitch_kpts = None; H_updated_this_frame = False
            try:
                if model_pitch:
                    results_pitch = model_pitch.predict(annotated_frame, imgsz=IMG_SIZE, conf=PITCH_LAYOUT_CONF_THRESHOLD, device=DEVICE, verbose=False)
                    if results_pitch and results_pitch[0]:
                        res_pitch = results_pitch[0]
                        # --- Added more checks for keypoints data structure ---
                        if (res_pitch.keypoints is not None and
                            hasattr(res_pitch.keypoints, 'conf') and res_pitch.keypoints.conf is not None and
                            hasattr(res_pitch.keypoints, 'xy') and res_pitch.keypoints.xy is not None and
                            len(res_pitch.keypoints.conf)>0 and res_pitch.keypoints.xy.shape[0]>0 and
                            res_pitch.keypoints.xy.shape[1]==num_kpts):
                            kxy=res_pitch.keypoints.xy[0].cpu().numpy(); kco=res_pitch.keypoints.conf[0].cpu().numpy().reshape(-1, 1)
                            # --- Check if keypoints array has the expected number of points ---
                            if kxy.shape[0]==num_kpts: # <-- Indent level 3
                                # Combine xy coordinates and confidence scores
                                pitch_kpts=np.hstack((kxy, kco)) # <-- Indent level 4
                                # Update the homography matrix using the detected keypoints
                                H_updated_this_frame=update_homography(pitch_kpts, PITCH_KPT_CONF_THRESHOLD, PITCH_LANDMARKS_2D_REF) # <-- Indent level 4

                                # --- Drawing Pitch Keypoints and Lines (NOW ENABLED) ---
                                # Optional: Draw detected keypoints and lines on the original frame
                                annotated_frame=draw_pitch_points_with_labels(annotated_frame, pitch_kpts, PITCH_KPT_CONF_THRESHOLD, PITCH_KPT_RADIUS, PITCH_KPT_COLOR, PITCH_KPT_TEXT_COLOR, 0.5) # <-- Indent level 4 (Uncommented)
                                annotated_frame=draw_pitch_lines_on_original(annotated_frame, pitch_kpts, PITCH_KPT_CONF_THRESHOLD, PITCH_LINE_KP_PAIRS, PITCH_LINE_COLOR_ORIGINAL, PITCH_LINE_THICKNESS_ORIGINAL) # <-- Indent level 4 (Uncommented)
                            # --- End of 'if kxy.shape[0]==num_kpts:' block ---
                        # --- End of 'if (res_pitch.keypoints is not None ...):' block ---
                    # --- End of 'if results_pitch and results_pitch[0]:' block ---
                # --- End of 'if model_pitch:' block ---
            # --- End of 'try:' block for pitch processing ---
            except Exception as pitch_err:
                print(f"\n⚠️ WARNING: Error during pitch/homography processing at frame {frame_idx}: {pitch_err}")
                # traceback.print_exc() # Optional: uncomment for full traceback
                H_updated_this_frame = False # Ensure H is not considered updated


            # --- 2. Player, Ball, Referee Detection ---
            current_frame_player_detections_with_features = []
            ball_detection_info = None; raw_detections_other = []
            try:
                if model_players:
                    results_players=model_players.predict(frame, imgsz=IMG_SIZE, conf=PLAYER_BALL_CONF_THRESHOLD, device=DEVICE, verbose=False)
                    if results_players and results_players[0] and results_players[0].boxes is not None:
                        for box in results_players[0].boxes:
                            # --- Add check for valid box data ---
                            if box.cls is None or box.conf is None or box.xyxy is None: continue
                            if len(box.cls) == 0 or len(box.conf) == 0 or len(box.xyxy) == 0: continue

                            cls_id=int(box.cls[0]); conf=float(box.conf[0]);
                            xyxy_cpu = box.xyxy[0].cpu().numpy()
                            # --- Add check for valid coordinates ---
                            if len(xyxy_cpu) < 4: continue
                            x1,y1,x2,y2=xyxy_cpu; x1,y1,x2,y2=max(0,int(x1)),max(0,int(y1)),min(w,int(x2)),min(h,int(y2))
                            if x2<=x1 or y2<=y1: continue

                            det_info={'box':np.array([x1,y1,x2,y2],dtype=np.float32), 'cls_id':cls_id, 'conf':conf}
                            if cls_id == PLAYER_CLS_ID: # Player color feature extraction
                                color_features=[]
                                try: # --- Inner try for feature extraction per player ---
                                    box_h=y2-y1
                                    if box_h <= 0 : continue # Skip if height is invalid
                                    roi_y1=max(y1,y1+int(box_h*ROI_START_PERCENT)); roi_y2=min(y2,y1+int(box_h*ROI_START_PERCENT+box_h*ROI_FOCUS_HEIGHT_PERCENT))
                                    if roi_y2 <= roi_y1: roi_y1 = y1; roi_y2 = y2 # Fallback
                                    if roi_y2 <= roi_y1: continue # Skip if still invalid

                                    roi_x1=x1; roi_x2=x2
                                    if roi_x2 <= roi_x1: continue # Skip if width is invalid

                                    patch=frame[roi_y1:roi_y2, roi_x1:roi_x2]
                                    if patch.size>0:
                                        hsv_patch=cv2.cvtColor(patch,cv2.COLOR_BGR2HSV); mask_general=cv2.inRange(hsv_patch,FEATURE_MASK_LOW_HSV,FEATURE_MASK_HIGH_HSV)
                                        if mask_general.size > 0 and cv2.countNonZero(mask_general)>(mask_general.size*0.05):
                                            avg_hsv=cv2.mean(hsv_patch,mask=mask_general)[:3]; color_features=list(avg_hsv) if np.all(np.isfinite(avg_hsv)) else []
                                except cv2.error as cv_err_feat:
                                    # print(f"DEBUG: OpenCV error extracting features for box {det_info['box']} at frame {frame_idx}: {cv_err_feat}") # Less verbose
                                    pass
                                except Exception as feat_err:
                                    # print(f"DEBUG: Unexpected error extracting features for box {det_info['box']} at frame {frame_idx}: {feat_err}") # Less verbose
                                    pass
                                current_frame_player_detections_with_features.append({'box':det_info['box'],'conf':det_info['conf'],'color_features':color_features,'match_found':False})
                            elif cls_id == BALL_CLS_ID: ball_detection_info = det_info
                            elif cls_id == REFEREE_CLS_ID: raw_detections_other.append(det_info)
            except Exception as detect_err:
                 print(f"\n⚠️ WARNING: Error during player/ball detection at frame {frame_idx}: {detect_err}")
                 # traceback.print_exc() # Optional: uncomment for full traceback
                 # Continue with potentially empty detection lists if error occurred mid-loop


            # =============================================================================
            # Tracking and KMeans Training Section (Starts below)
            # =============================================================================
            try: # --- Wrap Tracking and KMeans ---
                # --- 3. Tracking ---
                next_player_tracks = {}
                matched_detection_indices = set()

                # --- Match existing tracks ---
                for track_id, track_info in player_tracks.items():
                    if track_info['frames_since_match'] >= MAX_FRAMES_WITHOUT_MATCH: continue
                    best_match_idx = -1; best_iou = IOU_TRACKING_THRESHOLD
                    for i, det in enumerate(current_frame_player_detections_with_features):
                        if i in matched_detection_indices: continue
                        iou = calculate_iou(track_info['box'], det['box']) # Uses improved IOU func
                        if iou > best_iou: best_iou = iou; best_match_idx = i

                    if best_match_idx != -1:
                        matched_det = current_frame_player_detections_with_features[best_match_idx]
                        next_player_tracks[track_id] = {
                            'box': matched_det['box'], 'conf': matched_det['conf'], 'team_id': track_info['team_id'],
                            'frames_since_match': 0, 'color_features': matched_det['color_features'],
                            'frames_since_color_update': track_info.get('frames_since_color_update', 0) + 1,
                            'is_goalkeeper': track_info.get('is_goalkeeper', False), 'pos_2d': None
                        }
                        matched_detection_indices.add(best_match_idx)
                    else:
                        track_info['frames_since_match'] += 1
                        track_info['color_features'] = []
                        next_player_tracks[track_id] = track_info

                # --- Create new tracks ---
                for i, det in enumerate(current_frame_player_detections_with_features):
                    if i not in matched_detection_indices:
                        new_id = next_player_id; next_player_id += 1
                        next_player_tracks[new_id] = {
                            'box': det['box'], 'conf': det['conf'], 'team_id': -1, 'frames_since_match': 0,
                            'color_features': det['color_features'], 'frames_since_color_update': 0,
                            'is_goalkeeper': False, 'pos_2d': None
                        }
                player_tracks = next_player_tracks

                # --- 4. KMeans Training ---
                current_frame_valid_color_features=[t['color_features'] for t in player_tracks.values() if t['frames_since_match']==0 and t['color_features']]
                if current_frame_valid_color_features:
                    color_features_buffer.extend(current_frame_valid_color_features)
                    features_since_last_train+=len(current_frame_valid_color_features)

                should_train = ( (not kmeans_ready and frame_idx >= KMEANS_WARMUP_FRAMES and len(color_features_buffer) >= KMEANS_CLUSTERS * 5) or
                                 (kmeans_ready and (frame_idx - last_train_frame >= RETRAIN_INTERVAL_FRAMES) and len(color_features_buffer) >= KMEANS_CLUSTERS * 5 and features_since_last_train >= MIN_NEW_FEATURES_FOR_RETRAIN) )

                if should_train and SKLEARN_AVAILABLE:
