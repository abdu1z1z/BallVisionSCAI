def generate_report_images_and_data(frame_idx_val, current_fps_val, start_time_val):
    """Generates report images (Snapshot, Heatmap, Isolation) and prepares data dictionary."""
    global best_space_frame_data, ball_recoveries, fully_blocked_situations, heatmap_grid
    global possession_frames_team0, possession_frames_team1, poss_frames_t0_third1, poss_frames_t0_third2, poss_frames_t0_third3
    global poss_frames_t1_third1, poss_frames_t1_third2, poss_frames_t1_third3, open_lanes_count_t0, total_lanes_count_t0
    global open_lanes_count_t1, total_lanes_count_t1, pressure_index_sum_t0, pressure_frames_count_t0
    global pressure_index_sum_t1, pressure_frames_count_t1, VIDEO_PATH_IN
    global snapshot_success, recovery_heatmap_success, isolation_map_t0_success, isolation_map_t1_success, snapshot_pressure_info_text
    global PLAYER_CLS_ID, BALL_CLS_ID, REFEREE_CLS_ID

    print("\nGenerating report images and preparing data...")
    pitch_background_img = None
    if BACKGROUND_PITCH_IMAGE_PATH.exists():
        try:
            pitch_background_img = cv2.imread(str(BACKGROUND_PITCH_IMAGE_PATH))
            if pitch_background_img is None: print(f"⚠️ WARNING: Failed to load background image from {BACKGROUND_PITCH_IMAGE_PATH}.")
            else: print(f"ℹ️ Background image loaded for report.")
        except Exception as e: print(f"⚠️ WARNING: Error loading background image: {e}."); pitch_background_img = None
    else: print(f"⚠️ WARNING: Background image file not found at {BACKGROUND_PITCH_IMAGE_PATH}.")

    def get_base_image(target_w, target_h):
        if pitch_background_img is not None:
            try: return cv2.resize(pitch_background_img, (target_w, target_h), interpolation=cv2.INTER_AREA)
            except Exception as resize_err: print(f"⚠️ WARNING: Error resizing background image: {resize_err}. Using white fallback."); return np.ones((target_h, target_w, 3), dtype=np.uint8) * 255
        else: return np.ones((target_h, target_w, 3), dtype=np.uint8) * 255

    try:
        if SPACE_VIZ_ENABLED and best_space_frame_data.get('frame_idx', -1) != -1:
            print(f"Generating snapshot image (Frame {best_space_frame_data['frame_idx']})...")
            snapshot_h = 600; snapshot_w = int(snapshot_h * (PITCH_WIDTH_METERS / PITCH_HEIGHT_METERS)) if PITCH_HEIGHT_METERS > 0 else 0
            if snapshot_w > 0 and snapshot_h > 0:
                snapshot_img = get_base_image(snapshot_w, snapshot_h)
                report_scale_x = snapshot_w / PITCH_WIDTH_METERS if PITCH_WIDTH_METERS > 0 else 0
                report_scale_y = snapshot_h / PITCH_HEIGHT_METERS if PITCH_HEIGHT_METERS > 0 else 0
                if report_scale_x > 0 and report_scale_y > 0:
                    snapshot_carrier = None; snapshot_poss_team = -1; snapshot_ball_pos = None
                    for obj in best_space_frame_data.get('objects', []):
                        if obj.get('cls_id') == BALL_CLS_ID: snapshot_ball_pos = obj.get('pos_2d')
                    if snapshot_ball_pos is not None:
                        min_dist_snap = float('inf')
                        for obj in best_space_frame_data.get('objects', []):
                            if obj.get('cls_id') == PLAYER_CLS_ID and obj.get('pos_2d') is not None and obj.get('team_id',-1) != -1:
                                try:
                                    dist_snap = np.linalg.norm(obj['pos_2d'] - snapshot_ball_pos)
                                    if dist_snap < min_dist_snap and dist_snap < MIN_CARRIER_DIST: min_dist_snap = dist_snap; snapshot_carrier = obj; snapshot_poss_team = obj['team_id']
                                except Exception: pass
                    open_cells_data_snap = best_space_frame_data.get('open_cells', [])
                    if snapshot_poss_team != -1:
                        attacking_goal_x_report = PITCH_WIDTH_METERS if snapshot_poss_team == 0 else 0
                        grid_x_start = PITCH_HALFWAY_LINE_X if attacking_goal_x_report == PITCH_WIDTH_METERS else 0
                        grid_x_end = PITCH_WIDTH_METERS if attacking_goal_x_report == PITCH_WIDTH_METERS else PITCH_HALFWAY_LINE_X
                        grid_y_start=0; grid_y_end=PITCH_HEIGHT_METERS;
                        cell_width=(grid_x_end-grid_x_start)/SPACE_GRID_COLS if SPACE_GRID_COLS > 0 else 0
                        cell_height=(grid_y_end-grid_y_start)/SPACE_GRID_ROWS if SPACE_GRID_ROWS > 0 else 0
                        if cell_width > 0 and cell_height > 0:
                            for (r, c), cell_status in open_cells_data_snap:
                                cell_color = SPACE_OPEN_COLOR if cell_status == 'open' else SPACE_BLOCKED_COLOR
                                c_x1=int((grid_x_start+c*cell_width)*report_scale_x); c_y1=int(snapshot_h-(grid_y_start+(r+1)*cell_height)*report_scale_y)
                                c_x2=int((grid_x_start+(c+1)*cell_width)*report_scale_x); c_y2=int(snapshot_h-(grid_y_start+r*cell_height)*report_scale_y)
                                c_x1, c_y1 = max(0, c_x1), max(0, c_y1); c_x2, c_y2 = min(snapshot_w, c_x2), min(snapshot_h, c_y2)
                                if c_y1 < c_y2 and c_x1 < c_x2:
                                    try:
                                        roi = snapshot_img[c_y1:c_y2, c_x1:c_x2]
                                        if roi.size > 0:
                                            color_rect_roi = np.full(roi.shape, cell_color, dtype=np.uint8)
                                            alpha = SPACE_VIZ_ALPHA
                                            blended_roi = cv2.addWeighted(roi, 1.0 - alpha, color_rect_roi, alpha, 0.0)
                                            snapshot_img[c_y1:c_y2, c_x1:c_x2] = blended_roi
                                    except Exception: pass
                    for obj in best_space_frame_data.get('objects', []):
                        pos_2d_snap = obj.get('pos_2d')
                        if pos_2d_snap is not None:
                            sx, sy = pos_2d_snap; drx=int(sx*report_scale_x); dry=int(snapshot_h-(sy*report_scale_y))
                            snap_color=UNKNOWN_TEAM_COLOR; snap_team=obj.get('team_id'); cls_id_snap=obj.get('cls_id'); is_gk_snap = obj.get('is_goalkeeper', False)
                            if is_gk_snap: snap_color = GOALKEEPER_COLOR
                            elif snap_team == 0: snap_color = TEAM_0_COLOR
                            elif snap_team == 1: snap_color = TEAM_1_COLOR
                            elif cls_id_snap == BALL_CLS_ID: snap_color = BALL_COLOR
                            elif cls_id_snap == REFEREE_CLS_ID: snap_color = REFEREE_COLOR
                            radius = 4 if cls_id_snap == BALL_CLS_ID else 5; outline_color = (0, 0, 0)
                            if 0 <= drx < snapshot_w and 0 <= dry < snapshot_h:
                                cv2.circle(snapshot_img, (drx,dry), radius + 1, outline_color, -1); cv2.circle(snapshot_img, (drx,dry), radius, snap_color, -1)
                    if snapshot_carrier and snapshot_carrier.get('pos_2d') is not None:
                        snap_carrier_pos = snapshot_carrier['pos_2d']
                        snap_carrier_draw = (int(snap_carrier_pos[0]*report_scale_x), int(snapshot_h-(snap_carrier_pos[1]*report_scale_y)))
                        snap_teammates = [p for p in best_space_frame_data.get('objects',[]) if p.get('cls_id') == PLAYER_CLS_ID and p.get('pos_2d') is not None and p.get('team_id') == snapshot_poss_team and p.get('player_id') != snapshot_carrier.get('player_id')]
                        snap_opponents = [p for p in best_space_frame_data.get('objects',[]) if p.get('cls_id') == PLAYER_CLS_ID and p.get('pos_2d') is not None and p.get('team_id',-1) != -1 and p['team_id'] != snapshot_poss_team]
                        for tm in snap_teammates:
                            try: tm['dist_to_carrier'] = np.linalg.norm(tm['pos_2d'] - snap_carrier_pos)
                            except: tm['dist_to_carrier'] = float('inf')
                        snap_teammates.sort(key=lambda p: p.get('dist_to_carrier', float('inf')))
                        snap_teammates_to_draw = snap_teammates[:NEAREST_TEAMMATES_TO_SHOW]
                        opp_distances = []
                        for opp_snap in snap_opponents:
                            try: opp_distances.append(np.linalg.norm(opp_snap['pos_2d'] - snap_carrier_pos))
                            except: pass
                        opp_distances.sort()
                        if opp_distances: snapshot_pressure_info_text = "الضغط (أقرب 3 خصوم): " + ", ".join([f"{d:.1f}م" for d in opp_distances[:3]])
                        else: snapshot_pressure_info_text = "الضغط: لا يوجد خصوم قريبون"
                        (tw, th), bl = cv2.getTextSize(snapshot_pressure_info_text, cv2.FONT_HERSHEY_SIMPLEX, 0.5, 1)
                        cv2.rectangle(snapshot_img, (10, snapshot_h - 30 - th - 5), (10 + tw + 10, snapshot_h - 30 + bl), (255, 255, 255, 180), -1)
                        cv2.putText(snapshot_img, snapshot_pressure_info_text, (15, snapshot_h - 30), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0,0,0), 1, cv2.LINE_AA)
                        for tm_snap in snap_teammates_to_draw:
                            tm_pos_snap = tm_snap.get('pos_2d');
                            if tm_pos_snap is None: continue
                            tm_draw_snap = (int(tm_pos_snap[0]*report_scale_x), int(snapshot_h-(tm_pos_snap[1]*report_scale_y)))
                            min_opp_dist_map_snap = float('inf')
                            for opp_snap in snap_opponents:
                                if opp_snap.get('pos_2d') is None: continue
                                d_map_snap = point_segment_distance(opp_snap['pos_2d'][0], opp_snap['pos_2d'][1], snap_carrier_pos[0], snap_carrier_pos[1], tm_pos_snap[0], tm_pos_snap[1])
                                min_opp_dist_map_snap = min(min_opp_dist_map_snap, d_map_snap)
                            lane_color_snap = PASS_LANE_OPEN_COLOR if min_opp_dist_map_snap > PASS_LANE_BLOCK_THRESHOLD_MAP else PASS_LANE_BLOCKED_COLOR
                            if 0 <= snap_carrier_draw[0] < snapshot_w and 0 <= snap_carrier_draw[1] < snapshot_h and 0 <= tm_draw_snap[0] < snapshot_w and 0 <= tm_draw_snap[1] < snapshot_h:
                                cv2.line(snapshot_img, snap_carrier_draw, tm_draw_snap, lane_color_snap, PASS_LANE_THICKNESS + 1)
                    title_text = f"Key Moment - Space & Options (Frame: {best_space_frame_data.get('frame_idx', 'N/A')})"
                    (tw_title, th_title), bl_title = cv2.getTextSize(title_text, cv2.FONT_HERSHEY_SIMPLEX, 0.6, 2)
                    cv2.rectangle(snapshot_img, (5, 5), (15 + tw_title, 15 + th_title + bl_title), (255, 255, 255, 180), -1)
                    cv2.putText(snapshot_img, title_text, (10, 10 + th_title), cv2.FONT_HERSHEY_SIMPLEX, 0.6, (0,0,0), 2, cv2.LINE_AA)
                    snapshot_success = cv2.imwrite(str(SNAPSHOT_IMAGE_FILENAME), snapshot_img)
                    if not snapshot_success: print(f"❌ Error: Failed to save snapshot image to {SNAPSHOT_IMAGE_FILENAME}")
                    else: print(f"✅ Snapshot image saved to {SNAPSHOT_IMAGE_FILENAME}")
                else: print("⚠️ WARNING: Invalid scaling factors for snapshot image generation.")
        else: print("WARN: No significant open space snapshot captured for the report.")

        recovery_heatmap_success = False
        if ball_recoveries:
            print("Generating recovery heatmap image...")
            recovery_heatmap = np.zeros(HEATMAP_GRID_SIZE, dtype=np.float32)
            for recovery in ball_recoveries:
                rec_pos = recovery.get('pos_2d')
                if rec_pos is not None:
                    rx, ry = int(rec_pos[0] * scale2d), int((PITCH_HEIGHT_METERS - rec_pos[1]) * scale2d)
                    if 0 <= rx < map_w and 0 <= ry < map_h: recovery_heatmap[ry, rx] += 1.0
            if np.max(recovery_heatmap) > 0:
                rec_k_h = min(HEATMAP_BLUR_KERNEL[0], map_h - (1 if map_h%2==0 else 0)); rec_k_w = min(HEATMAP_BLUR_KERNEL[1], map_w - (1 if map_w%2==0 else 0))
                if rec_k_h > 0 and rec_k_w > 0: rec_h_blur = cv2.GaussianBlur(recovery_heatmap, (rec_k_h, rec_k_w), 0)
                else: rec_h_blur = recovery_heatmap
                rec_max_h = np.max(rec_h_blur)
                if rec_max_h > 0:
                    rec_h_norm = np.uint8(255 * rec_h_blur / rec_max_h)
                    rec_h_color = cv2.applyColorMap(rec_h_norm, cv2.COLORMAP_HOT)
                    recovery_pitch_bg = get_base_image(map_w, map_h)
                    draw_pitch_outline(recovery_pitch_bg, 0, 0, map_w, map_h, PITCH_LINE_COLOR_2D, PITCH_LINE_THICKNESS_2D)
                    rec_alpha = 0.65
                    recovery_heatmap_img = cv2.addWeighted(rec_h_color, rec_alpha, recovery_pitch_bg, 1.0 - rec_alpha, 0)
                    recovery_heatmap_success = cv2.imwrite(str(RECOVERY_HEATMAP_FILENAME), recovery_heatmap_img)
                    if not recovery_heatmap_success: print(f"❌ Error: Failed to save recovery heatmap image to {RECOVERY_HEATMAP_FILENAME}")
                    else: print(f"✅ Recovery heatmap image saved to {RECOVERY_HEATMAP_FILENAME}")
                else: print("WARN: Recovery heatmap has zero maximum after blur.")
            else: print("WARN: No recovery points to generate heatmap.")
        else: print("WARN: No ball recoveries recorded.")

        isolation_map_t0_success = False; isolation_map_t1_success = False
        if fully_blocked_situations:
            print("Generating isolation map images...")
            iso_map_t0 = get_base_image(map_w, map_h); iso_map_t1 = get_base_image(map_w, map_h)
            draw_pitch_outline(iso_map_t0, 0, 0, map_w, map_h, PITCH_LINE_COLOR_2D, PITCH_LINE_THICKNESS_2D)
            draw_pitch_outline(iso_map_t1, 0, 0, map_w, map_h, PITCH_LINE_COLOR_2D, PITCH_LINE_THICKNESS_2D)
            for sit in fully_blocked_situations:
                team_id = sit.get('team_id', -1); pos_2d = sit.get('pos_2d'); third = sit.get('third', -1)
                if pos_2d is None or team_id == -1 or third == -1: continue
                draw_x = int(pos_2d[0] * scale2d); draw_y = int((PITCH_HEIGHT_METERS - pos_2d[1]) * scale2d)
                if not (0 <= draw_x < map_w and 0 <= draw_y < map_h): continue
                marker_color = UNKNOWN_TEAM_COLOR
                if team_id == 0:
                    if third == 1: marker_color = ISOLATION_COLOR_DEF_THIRD
                    elif third == 2: marker_color = ISOLATION_COLOR_MID_THIRD
                    elif third == 3: marker_color = ISOLATION_COLOR_ATT_THIRD
                elif team_id == 1:
                    if third == 1: marker_color = ISOLATION_COLOR_ATT_THIRD
                    elif third == 2: marker_color = ISOLATION_COLOR_MID_THIRD
                    elif third == 3: marker_color = ISOLATION_COLOR_DEF_THIRD
                outline_color_iso = (0,0,0); target_map = iso_map_t0 if team_id == 0 else iso_map_t1
                cv2.circle(target_map, (draw_x, draw_y), ISOLATION_MARKER_RADIUS + 1, outline_color_iso, -1)
                cv2.circle(target_map, (draw_x, draw_y), ISOLATION_MARKER_RADIUS, marker_color, -1)
            isolation_map_t0_success = cv2.imwrite(str(ISOLATION_MAP_T0_FILENAME), iso_map_t0)
            isolation_map_t1_success = cv2.imwrite(str(ISOLATION_MAP_T1_FILENAME), iso_map_t1)
            if not isolation_map_t0_success: print(f"❌ Error saving Team 0 isolation map: {ISOLATION_MAP_T0_FILENAME}")
            else: print(f"✅ Team 0 Isolation map saved to {ISOLATION_MAP_T0_FILENAME}")
            if not isolation_map_t1_success: print(f"❌ Error saving Team 1 isolation map: {ISOLATION_MAP_T1_FILENAME}")
            else: print(f"✅ Team 1 Isolation map saved to {ISOLATION_MAP_T1_FILENAME}")
        else: print("WARN: No fully blocked situations recorded for isolation maps.")

    except Exception as report_img_err:
        print(f"❌ ERROR generating report images: {report_img_err}")
        traceback.print_exc()
        snapshot_success = False; recovery_heatmap_success = False; isolation_map_t0_success = False; isolation_map_t1_success = False

    print("\nCalculating final statistics...")
    end_time_total = time.time()
    total_processing_time = end_time_total - start_time_val # Use passed start_time
    average_fps = frame_idx_val / total_processing_time if total_processing_time > 0 else 0
