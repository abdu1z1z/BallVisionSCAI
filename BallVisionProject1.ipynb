                        if ball_x < PITCH_THIRD_1_END_X: poss_frames_t0_third1 += 1; current_ball_third = 1
                        elif ball_x < PITCH_THIRD_2_END_X: poss_frames_t0_third2 += 1; current_ball_third = 2
                        else: poss_frames_t0_third3 += 1; current_ball_third = 3
                    elif current_possessing_team_id == 1:
                        possession_frames_team1 += 1
                        if ball_x > PITCH_THIRD_2_END_X: poss_frames_t1_third3 += 1; current_ball_third = 3
                        elif ball_x > PITCH_THIRD_1_END_X: poss_frames_t1_third2 += 1; current_ball_third = 2
                        else: poss_frames_t1_third1 += 1; current_ball_third = 1

