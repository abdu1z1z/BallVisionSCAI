    final_poss_perc_t0 = (possession_frames_team0 / total_possession_frames) * 100 if total_possession_frames > 0 else 0
    final_poss_perc_t1 = (possession_frames_team1 / total_possession_frames) * 100 if total_possession_frames > 0 else 0
    t0_total_poss = poss_frames_t0_third1 + poss_frames_t0_third2 + poss_frames_t0_third3
    t1_total_poss = poss_frames_t1_third1 + poss_frames_t1_third2 + poss_frames_t1_third3
    t0_def_perc = (poss_frames_t0_third1 / t0_total_poss) * 100 if t0_total_poss > 0 else 0
    t0_mid_perc = (poss_frames_t0_third2 / t0_total_poss) * 100 if t0_total_poss > 0 else 0
    t0_att_perc = (poss_frames_t0_third3 / t0_total_poss) * 100 if t0_total_poss > 0 else 0
    t1_def_perc = (poss_frames_t1_third1 / t1_total_poss) * 100 if t1_total_poss > 0 else 0
    t1_mid_perc = (poss_frames_t1_third2 / t1_total_poss) * 100 if t1_total_poss > 0 else 0
    t1_att_perc = (poss_frames_t1_third3 / t1_total_poss) * 100 if t1_total_poss > 0 else 0
    t0_eff = f"{t0_att_perc / t0_def_perc:.2f}" if t0_def_perc > 0 else "N/A"
    t1_eff = f"{t1_att_perc / t1_def_perc:.2f}" if t1_def_perc > 0 else "N/A"
    avg_lane_open_t0 = (open_lanes_count_t0 / total_lanes_count_t0) * 100 if total_lanes_count_t0 > 0 else 0
    avg_lane_open_t1 = (open_lanes_count_t1 / total_lanes_count_t1) * 100 if total_lanes_count_t1 > 0 else 0
    avg_pressure_t0 = pressure_index_sum_t0 / pressure_frames_count_t0 if pressure_frames_count_t0 > 0 else 0.0
    avg_pressure_t1 = pressure_index_sum_t1 / pressure_frames_count_t1 if pressure_frames_count_t1 > 0 else 0.0
    top_recoverers_list = []
    if ball_recoveries:
        try:
            recovery_counts = Counter(rec.get('player_id') for rec in ball_recoveries if rec.get('player_id') is not None)
            top_recoverers_list = recovery_counts.most_common(5)
        except Exception as e: print(f"⚠️ WARNING: Error processing ball recoveries: {e}")

    report_data = {
        'video_name': str(VIDEO_PATH_IN.name), 'duration': float(total_processing_time), 'total_frames': int(frame_idx_val),
        'avg_fps': float(average_fps), 'poss_t0': float(final_poss_perc_t0), 'poss_t1': float(final_poss_perc_t1),
        'lanes_t0': float(avg_lane_open_t0), 'lanes_t1': float(avg_lane_open_t1),
        'pressure_t0': float(avg_pressure_t1), 'pressure_t1': float(avg_pressure_t0),
        't0_def': float(t0_def_perc), 't0_mid': float(t0_mid_perc), 't0_att': float(t0_att_perc), 't0_eff': str(t0_eff),
        't1_def': float(t1_def_perc), 't1_mid': float(t1_mid_perc), 't1_att': float(t1_att_perc), 't1_eff': str(t1_eff),
        'recovery_success': bool(recovery_heatmap_success), 'recovery_file': str(RECOVERY_HEATMAP_FILENAME.name) if recovery_heatmap_success else "",
        'all_recoveries': ball_recoveries, 'top_recoverers': top_recoverers_list,
        'isolation_t0_success': bool(isolation_map_t0_success), 'isolation_t0_file': str(ISOLATION_MAP_T0_FILENAME.name) if isolation_map_t0_success else "",
        'isolation_t1_success': bool(isolation_map_t1_success), 'isolation_t1_file': str(ISOLATION_MAP_T1_FILENAME.name) if isolation_map_t1_success else "",
        'snapshot_success': bool(snapshot_success), 'snapshot_file': str(SNAPSHOT_IMAGE_FILENAME.name) if snapshot_success else "",
        'snapshot_frame': int(best_space_frame_data.get('frame_idx', -1)),
        'snapshot_pressure': str(snapshot_pressure_info_text),
        # --- ✅ Add more snapshot specific data if needed for dynamic insights ---
        'snapshot_open_lanes_count': sum(1 for _, status in best_space_frame_data.get('open_cells', []) if status == 'open') if snapshot_success else 0,
        'snapshot_closest_opponent_dist': "N/A" # Placeholder, needs calculation if desired
    }

    # --- ✅ Print some report_data for verification ---
    print("\n--- Data being sent to HTML template (sample) ---")
    print(f"  Video Name: {report_data.get('video_name')}")
    print(f"  Team 0 Possession: {report_data.get('poss_t0')}%")
    print(f"  Team 1 Possession: {report_data.get('poss_t1')}%")
    print(f"  Snapshot Frame: {report_data.get('snapshot_frame')}")
    print(f"  Lanes T0: {report_data.get('lanes_t0')}%")
    print("---------------------------------------------------")

    print("\nAttempting to generate HTML report...")
    if HTML_TEMPLATE_PATH.exists():
        print(f"Using HTML template: {HTML_TEMPLATE_PATH}")
        print(f"Writing HTML report to: {REPORT_FILENAME_HTML}")
        report_generated = generate_html_report_from_template(report_data, HTML_TEMPLATE_PATH, REPORT_FILENAME_HTML)
        if report_generated:
            print(f"✅ HTML Report generation successful: {REPORT_FILENAME_HTML.resolve()}")
            print(f"   ➡️ Please open THIS FILE in your browser: {REPORT_FILENAME_HTML.resolve()}")
        else:
            print(f"❌ HTML Report generation failed.")
    else:
        print(f"⚠️ HTML Template not found at {HTML_TEMPLATE_PATH}. Cannot generate HTML report.")


# =============================================================================
# Main Processing Function
