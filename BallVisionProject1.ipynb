                                    best_space_frame_data['objects'] = [{'cls_id': obj.get('cls_id'), 'team_id': obj.get('team_id'), 'is_goalkeeper': obj.get('is_goalkeeper', False), 'pos_2d': obj.get('pos_2d').copy() if obj.get('pos_2d') is not None else None, 'player_id': obj.get('player_id')} for obj in final_objects_for_drawing if obj.get('pos_2d') is not None]

