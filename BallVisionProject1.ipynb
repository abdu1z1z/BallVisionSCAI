                # Aggregate ball and referee, calculate 2D pos
                all_other_detections = raw_detections_other + ([ball_detection_info] if ball_detection_info else [])
                for det in all_other_detections:
                    obj_pos_img_bottom = np.array([(det['box'][0]+det['box'][2])/2, det['box'][3]], dtype=np.float32)
