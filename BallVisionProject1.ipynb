                        defenders = [p for p in final_objects_for_drawing if p['cls_id'] == PLAYER_CLS_ID and p.get('pos_2d') is not None and p['team_id'] != -1 and p['team_id'] != space_viz_attacking_team_id and not p.get('is_goalkeeper', False)]
                        if defenders:
                            if attacking_goal_x == PITCH_WIDTH_METERS: grid_x_start = 52.5; grid_x_end = 105
                            else: grid_x_start = 0; grid_x_end = 52.5
                            grid_y_start=0; grid_y_end=68; cell_width=(grid_x_end-grid_x_start)/SPACE_GRID_COLS; cell_height=(grid_y_end-grid_y_start)/SPACE_GRID_ROWS
                            if cell_width <= 0 or cell_height <= 0: # Avoid division by zero in grid calc
                                print(f"⚠️ WARNING: Invalid cell dimensions for space viz at frame {frame_idx}")
                            else:
                                for r in range(SPACE_GRID_ROWS):
                                    for c in range(SPACE_GRID_COLS):
                                        cell_center_x = grid_x_start + (c+0.5)*cell_width; cell_center_y = grid_y_start + (r+0.5)*cell_height; cell_center_pos = np.array([cell_center_x, cell_center_y])
                                        min_dist_to_defender = float('inf')
                                        for d in defenders:
                                            try: min_dist_to_defender = min(min_dist_to_defender, np.linalg.norm(d['pos_2d'] - cell_center_pos))
                                            except: pass # Ignore errors during distance calc
                                        cell_status = 'open' if min_dist_to_defender > MIN_SPACE_DISTANCE else 'blocked'
                                        is_relevant = (attacking_goal_x == PITCH_WIDTH_METERS and cell_center_x >= space_viz_carrier_pos[0] - cell_width) or \
