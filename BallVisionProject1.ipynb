                                    temp_cluster_map[cluster_indices_sorted_by_sat[1]] = 1
                                    # print(f"Cluster Map (Sat Sort): Navy={cluster_indices_sorted_by_sat[0]}->0, White={cluster_indices_sorted_by_sat[1]}->1") # Less verbose
                                except IndexError:
                                    print("⚠️ WARN: IndexError during cluster sorting, using default map.")
                                    for i in range(centers_original.shape[0]): temp_cluster_map[i] = i % 2
                            else:
                                print("⚠️ WARN: KMeans map default assignment due to insufficient clusters/dims.")
                                for i in range(centers_original.shape[0]): temp_cluster_map[i] = i % 2
                            cluster_label_map = temp_cluster_map
                            label_clusters_by_color(centers_original, cluster_label_map)
                            kmeans_ready = True
                            last_train_frame = frame_idx
                            features_since_last_train = 0
                            print("✅ KMeans training successful.")
                        except Exception as kmeans_train_err:
                            print(f"\n❌ KMeans Error during training/labeling at frame {frame_idx}: {kmeans_train_err}")
                            traceback.print_exc()
                            kmeans_ready=False # Crucial: Mark as not ready if training failed
                            cluster_label_map = {} # Clear map

            except Exception as track_kmeans_err:
                 print(f"\n⚠️ WARNING: Error during Tracking or KMeans setup at frame {frame_idx}: {track_kmeans_err}")
                 # traceback.print_exc() # Optional: uncomment for full traceback
                 # Allow loop to continue, tracking might be inconsistent for this frame


            # --- 5. Update 2D Positions & Team Classification ---
            try: # --- Wrap Position/Classification ---
                if H_global is not None:
